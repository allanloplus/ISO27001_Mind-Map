[
 {
  "dur": 15.77,
  "lines": [
   {
    "who": "A",
    "text": "哈囉，大家好！我是羅宇倫，Allan 老師。今天我們用一張心智圖，輕鬆搞懂 ISO 27001！",
    "start": 1.0,
    "end": 9.48
   },
   {
    "who": "R",
    "text": "我是助教阿拉蕾！哇～好期待喔，大家一起加油！",
    "start": 9.78,
    "end": 14.96
   }
  ]
 },
 {
  "dur": 16.36,
  "lines": [
   {
    "who": "A",
    "text": "先來看全貌！正中間是 ISO 27001 二〇二二年版。往上是本文，往右是附錄 A，再順著這條虛線，就會連到從流程角度整理的運作能力。",
    "start": 0.5,
    "end": 12.03
   },
   {
    "who": "R",
    "text": "一張圖就看完整本標準，好厲害！",
    "start": 12.33,
    "end": 15.56
   }
  ]
 },
 {
  "dur": 13.31,
  "lines": [
   {
    "who": "A",
    "text": "本文有零到十章。其中第四到第十章，是驗證時一定要做到的要求喔！它們依照規劃、支援、執行、檢查、行動，一圈一圈地持續運轉。",
    "start": 0.5,
    "end": 12.51
   }
  ]
 },
 {
  "dur": 14.48,
  "lines": [
   {
    "who": "A",
    "text": "第四章，組織全景。先看清楚公司內外部的議題，還有關注方想要什麼。新版特別要求：要決定哪些要求，交給資訊安全管理系統來處理，最後再畫出範圍。",
    "start": 0.5,
    "end": 13.68
   }
  ]
 },
 {
  "dur": 14.8,
  "lines": [
   {
    "who": "A",
    "text": "第五章，領導作為。老闆要親自訂政策、給資源、指派角色和權責。",
    "start": 0.5,
    "end": 6.92
   },
   {
    "who": "R",
    "text": "所以資訊安全，不是只有資訊部門的事喔！",
    "start": 7.22,
    "end": 10.96
   },
   {
    "who": "A",
    "text": "沒錯！阿拉蕾說得很好。",
    "start": 11.26,
    "end": 14.0
   }
  ]
 },
 {
  "dur": 16.9,
  "lines": [
   {
    "who": "A",
    "text": "第六章，規劃，這是整本標準最核心的地方！先訂好風險準則，把風險找出來、分析、評估；再決定怎麼處理，對照附錄 A，產出適用性聲明。最後，還要訂出可以量測的資安目標。",
    "start": 0.5,
    "end": 16.1
   }
  ]
 },
 {
  "dur": 9.03,
  "lines": [
   {
    "who": "A",
    "text": "第七章，支援。資源、能力、認知、溝通，還有文件化資訊，都要準備到位。",
    "start": 0.5,
    "end": 8.23
   }
  ]
 },
 {
  "dur": 10.68,
  "lines": [
   {
    "who": "A",
    "text": "第八章，運作。說到就要做到！把第六章規劃好的風險評鑑和處理計畫，確實執行，並且留下紀錄。",
    "start": 0.5,
    "end": 9.88
   }
  ]
 },
 {
  "dur": 8.84,
  "lines": [
   {
    "who": "A",
    "text": "第九章，績效評估。用監視量測、內部稽核、管理審查，定期檢查系統到底有沒有效。",
    "start": 0.5,
    "end": 8.04
   }
  ]
 },
 {
  "dur": 14.32,
  "lines": [
   {
    "who": "A",
    "text": "第十章，改善。發現不符合的時候，先矯正，再找出根本原因，採取矯正措施。",
    "start": 0.5,
    "end": 7.81
   },
   {
    "who": "R",
    "text": "就是先滅火，再想辦法不要再失火！",
    "start": 8.11,
    "end": 11.68
   },
   {
    "who": "A",
    "text": "哈哈，比喻得太好了！",
    "start": 11.98,
    "end": 13.52
   }
  ]
 },
 {
  "dur": 16.0,
  "lines": [
   {
    "who": "A",
    "text": "接下來看附錄 A！一共有四個主題、九十三項控制：組織三十七項、人員八項、實體十四項、技術三十四項。",
    "start": 0.5,
    "end": 9.64
   },
   {
    "who": "R",
    "text": "哇～九十三項！好多喔！",
    "start": 9.94,
    "end": 13.03
   },
   {
    "who": "A",
    "text": "別擔心，我們一個一個來看。",
    "start": 13.33,
    "end": 15.2
   }
  ]
 },
 {
  "dur": 8.77,
  "lines": [
   {
    "who": "A",
    "text": "A.5 組織控制最多，從政策、資產、存取、供應商，一路到資安事件、營運持續和法規遵循。",
    "start": 0.5,
    "end": 7.97
   }
  ]
 },
 {
  "dur": 8.0,
  "lines": [
   {
    "who": "A",
    "text": "A.6 人員控制，就照著員工的聘用前、聘用中、離職後來安排。",
    "start": 0.5,
    "end": 5.18
   }
  ]
 },
 {
  "dur": 8.0,
  "lines": [
   {
    "who": "A",
    "text": "A.7 實體控制，分成安全區域和設備兩大類。",
    "start": 0.5,
    "end": 3.7
   }
  ]
 },
 {
  "dur": 8.0,
  "lines": [
   {
    "who": "A",
    "text": "A.8 技術控制有三十四項。新版新增的十一項控制裡，就有七項在這裡喔！",
    "start": 0.5,
    "end": 6.4
   }
  ]
 },
 {
  "dur": 11.74,
  "lines": [
   {
    "who": "A",
    "text": "ISO 27002 幫每一項控制，都貼上五種屬性標籤。其中最實用的就是「運作能力」，它讓我們從流程的角度，把九十三項控制重新串起來。",
    "start": 0.5,
    "end": 10.94
   }
  ]
 },
 {
  "dur": 11.37,
  "lines": [
   {
    "who": "R",
    "text": "阿拉蕾來數數看，一、二、三……一共有十五項運作能力！",
    "start": 0.5,
    "end": 5.55
   },
   {
    "who": "A",
    "text": "答對了！旁邊的數字，就是每一項能力對應的控制數量。",
    "start": 5.85,
    "end": 10.57
   }
  ]
 },
 {
  "dur": 8.0,
  "lines": [
   {
    "who": "A",
    "text": "第一個，治理：由高階主管核准政策，定義角色和職務區隔，並要求大家確實遵守。",
    "start": 0.5,
    "end": 6.99
   }
  ]
 },
 {
  "dur": 8.0,
  "lines": [
   {
    "who": "A",
    "text": "人資安全：從聘用前的背景調查，到在職的教育訓練，再到離職後的保密責任。",
    "start": 0.5,
    "end": 6.06
   }
  ]
 },
 {
  "dur": 8.41,
  "lines": [
   {
    "who": "A",
    "text": "資訊保護：從分級、標示、使用、傳送、儲存，一直到刪除，全程保護資訊。",
    "start": 0.5,
    "end": 7.61
   }
  ]
 },
 {
  "dur": 8.0,
  "lines": [
   {
    "who": "A",
    "text": "資產管理：先建立資產清冊，再管好場所內外的使用、歸還和汰除。",
    "start": 0.5,
    "end": 5.84
   }
  ]
 },
 {
  "dur": 9.38,
  "lines": [
   {
    "who": "A",
    "text": "存取管理：依照業務需求訂規則，管好帳號身分、密碼和存取權限。",
    "start": 0.5,
    "end": 5.88
   },
   {
    "who": "R",
    "text": "密碼不可以貼在螢幕上喔！",
    "start": 6.18,
    "end": 8.58
   }
  ]
 },
 {
  "dur": 8.0,
  "lines": [
   {
    "who": "A",
    "text": "保全組態：以組態管理為中心，管住軟體安裝、特權工具和加密技術。",
    "start": 0.5,
    "end": 5.59
   }
  ]
 },
 {
  "dur": 8.0,
  "lines": [
   {
    "who": "A",
    "text": "實體安全：由外而內，守住安全區域，再把設備從安置到報廢都管好。",
    "start": 0.5,
    "end": 5.72
   }
  ]
 },
 {
  "dur": 8.94,
  "lines": [
   {
    "who": "A",
    "text": "威脅與弱點管理：蒐集威脅情資，評估技術弱點，然後趕快採取行動！",
    "start": 0.5,
    "end": 5.78
   },
   {
    "who": "R",
    "text": "知己知彼，百戰百勝！",
    "start": 6.08,
    "end": 8.14
   }
  ]
 },
 {
  "dur": 8.0,
  "lines": [
   {
    "who": "A",
    "text": "應用程式安全：把安全放進需求、架構、寫程式、測試到上線的每一個步驟。",
    "start": 0.5,
    "end": 6.47
   }
  ]
 },
 {
  "dur": 8.0,
  "lines": [
   {
    "who": "A",
    "text": "系統與網路安全：從組態、網路服務、網段區隔到網頁過濾，一層一層地防護。",
    "start": 0.5,
    "end": 6.62
   }
  ]
 },
 {
  "dur": 8.0,
  "lines": [
   {
    "who": "A",
    "text": "供應者關係安全：從合約、資通訊供應鏈到雲端服務，把外部風險管好。",
    "start": 0.5,
    "end": 6.02
   }
  ]
 },
 {
  "dur": 11.73,
  "lines": [
   {
    "who": "A",
    "text": "資安事件管理：事前準備、即時通報、評估、回應，事後還要學習改進，並保存證據。",
    "start": 0.5,
    "end": 7.55
   },
   {
    "who": "R",
    "text": "發現可疑的事情，要馬上通報喔！",
    "start": 7.85,
    "end": 10.93
   }
  ]
 },
 {
  "dur": 8.0,
  "lines": [
   {
    "who": "A",
    "text": "持續性：先訂好復原時間目標，確保發生中斷時，資安和資訊服務都還能撐得住。",
    "start": 0.5,
    "end": 6.46
   }
  ]
 },
 {
  "dur": 8.0,
  "lines": [
   {
    "who": "A",
    "text": "資訊安全保證：透過遵循性審查、獨立審查和安全測試，證明控制真的有效。",
    "start": 0.5,
    "end": 6.35
   }
  ]
 },
 {
  "dur": 10.78,
  "lines": [
   {
    "who": "A",
    "text": "最後一個，遵循性：掌握法規和合約的要求，保護智慧財產、紀錄和個人資料。",
    "start": 0.5,
    "end": 6.78
   },
   {
    "who": "R",
    "text": "十五項全部完成！耶～",
    "start": 7.08,
    "end": 9.98
   }
  ]
 },
 {
  "dur": 15.62,
  "lines": [
   {
    "who": "A",
    "text": "總結一下！本文告訴我們管理系統怎麼運轉，附錄 A 提供控制措施，運作能力把它們串成可以落地的流程。謝謝大家的收看！",
    "start": 0.5,
    "end": 10.71
   },
   {
    "who": "R",
    "text": "謝謝大家，我們下次見！掰掰～",
    "start": 11.01,
    "end": 14.82
   }
  ]
 }
]
