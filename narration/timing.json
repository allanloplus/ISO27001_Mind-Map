[
 {
  "dur": 14.56,
  "lines": [
   {
    "who": "A",
    "text": "大家好，我是羅宇倫 Allan。今天用一張心智圖，帶大家在五分鐘內看懂 ISO 27001。",
    "start": 1.0,
    "end": 10.23
   },
   {
    "who": "R",
    "text": "我是助教阿拉蕾！大家一起加油～",
    "start": 10.53,
    "end": 13.96
   }
  ]
 },
 {
  "dur": 14.22,
  "lines": [
   {
    "who": "A",
    "text": "這張心智圖以 ISO 27001 二〇二二年版為核心：上面是本文，右邊是附錄 A，再用虛線連到從流程角度重組的運作能力。",
    "start": 0.5,
    "end": 13.62
   }
  ]
 },
 {
  "dur": 11.26,
  "lines": [
   {
    "who": "A",
    "text": "本文有零到十章。第四到十章是驗證一定要做的要求，依照規劃、支援、執行、檢查、行動的循環來運轉。",
    "start": 0.5,
    "end": 10.66
   }
  ]
 },
 {
  "dur": 11.95,
  "lines": [
   {
    "who": "A",
    "text": "第四章組織全景：先找出內外部議題和關注方的要求，新版還要決定哪些要求由資訊安全管理系統來因應，再界定範圍。",
    "start": 0.5,
    "end": 11.35
   }
  ]
 },
 {
  "dur": 12.24,
  "lines": [
   {
    "who": "A",
    "text": "第五章領導作為：最高管理階層要訂政策、給資源、指派角色與權責。",
    "start": 0.5,
    "end": 7.53
   },
   {
    "who": "R",
    "text": "所以資訊安全，不只是資訊部門的事喔！",
    "start": 7.83,
    "end": 11.64
   }
  ]
 },
 {
  "dur": 16.69,
  "lines": [
   {
    "who": "A",
    "text": "第六章規劃，是整個標準的核心。先建立風險準則，識別、分析、評估風險，再選擇處理方式、比對附錄 A，產出適用性聲明，並訂定可量測的資安目標。",
    "start": 0.5,
    "end": 16.09
   }
  ]
 },
 {
  "dur": 7.34,
  "lines": [
   {
    "who": "A",
    "text": "第七章支援：包括資源、能力、認知、溝通，以及文件化資訊的管理。",
    "start": 0.5,
    "end": 6.74
   }
  ]
 },
 {
  "dur": 7.79,
  "lines": [
   {
    "who": "A",
    "text": "第八章運作：把第六章的風險評鑑與風險處理計畫確實執行，並留下紀錄。",
    "start": 0.5,
    "end": 7.19
   }
  ]
 },
 {
  "dur": 9.77,
  "lines": [
   {
    "who": "A",
    "text": "第九章績效評估：透過監視量測、內部稽核和管理審查，確認管理系統是否有效。",
    "start": 0.5,
    "end": 9.17
   }
  ]
 },
 {
  "dur": 11.72,
  "lines": [
   {
    "who": "A",
    "text": "第十章改善：發生不符合時，先矯正，再找出根因，採取矯正措施。",
    "start": 0.5,
    "end": 7.56
   },
   {
    "who": "R",
    "text": "先滅火，再防止火災再發生！",
    "start": 7.86,
    "end": 11.12
   }
  ]
 },
 {
  "dur": 13.79,
  "lines": [
   {
    "who": "A",
    "text": "附錄 A 共有四個主題、九十三項控制：組織三十七項、人員八項、實體十四項、技術三十四項。",
    "start": 0.5,
    "end": 10.82
   },
   {
    "who": "R",
    "text": "哇～九十三項，好多喔！",
    "start": 11.12,
    "end": 13.19
   }
  ]
 },
 {
  "dur": 9.15,
  "lines": [
   {
    "who": "A",
    "text": "A.5 組織控制最多，從政策、資產、存取、供應商，到資安事件、營運持續與遵循。",
    "start": 0.5,
    "end": 8.55
   }
  ]
 },
 {
  "dur": 7.1,
  "lines": [
   {
    "who": "A",
    "text": "A.6 人員控制，照著聘用前、聘用中、解聘後來安排。",
    "start": 0.5,
    "end": 6.5
   }
  ]
 },
 {
  "dur": 5.83,
  "lines": [
   {
    "who": "A",
    "text": "A.7 實體控制，分成安全區域與設備兩大類。",
    "start": 0.5,
    "end": 5.23
   }
  ]
 },
 {
  "dur": 8.25,
  "lines": [
   {
    "who": "A",
    "text": "A.8 技術控制有三十四項，新版新增的十一項控制，有七項在這裡。",
    "start": 0.5,
    "end": 7.65
   }
  ]
 },
 {
  "dur": 12.47,
  "lines": [
   {
    "who": "A",
    "text": "ISO 27002 為每一項控制加上五種屬性。其中「運作能力」，讓我們從流程面，重新串起這九十三項控制。",
    "start": 0.5,
    "end": 11.87
   }
  ]
 },
 {
  "dur": 10.45,
  "lines": [
   {
    "who": "R",
    "text": "阿拉蕾來數數看，一共有十五項運作能力！",
    "start": 0.5,
    "end": 4.6
   },
   {
    "who": "A",
    "text": "沒錯，節點旁的數字，就是對應的控制數量。",
    "start": 4.9,
    "end": 9.85
   }
  ]
 },
 {
  "dur": 8.19,
  "lines": [
   {
    "who": "A",
    "text": "治理：由高階核准政策，定義角色與職務區隔，並要求人員遵循。",
    "start": 0.5,
    "end": 7.59
   }
  ]
 },
 {
  "dur": 8.02,
  "lines": [
   {
    "who": "A",
    "text": "人資安全：從聘用前的背景調查，到教育訓練，再到離職後的責任。",
    "start": 0.5,
    "end": 7.42
   }
  ]
 },
 {
  "dur": 7.86,
  "lines": [
   {
    "who": "A",
    "text": "資訊保護：沿著分級、標示、使用、傳送、儲存到刪除，一路保護資訊。",
    "start": 0.5,
    "end": 7.26
   }
  ]
 },
 {
  "dur": 7.48,
  "lines": [
   {
    "who": "A",
    "text": "資產管理：從資產清冊開始，管到場所內外、歸還與汰除。",
    "start": 0.5,
    "end": 6.88
   }
  ]
 },
 {
  "dur": 8.02,
  "lines": [
   {
    "who": "A",
    "text": "存取管理：依業務需求訂規則，管好身分、鑑別資訊與存取權限。",
    "start": 0.5,
    "end": 7.42
   }
  ]
 },
 {
  "dur": 8.39,
  "lines": [
   {
    "who": "A",
    "text": "保全組態：以組態管理為中心，管住軟體安裝、特權工具與密碼技術。",
    "start": 0.5,
    "end": 7.79
   }
  ]
 },
 {
  "dur": 7.66,
  "lines": [
   {
    "who": "A",
    "text": "實體安全：由外而內守住安全區域，再管好設備的整個生命週期。",
    "start": 0.5,
    "end": 7.06
   }
  ]
 },
 {
  "dur": 9.44,
  "lines": [
   {
    "who": "A",
    "text": "威脅與弱點管理：把威脅情資和技術脆弱性管理串成循環。",
    "start": 0.5,
    "end": 6.32
   },
   {
    "who": "R",
    "text": "知己知彼，百戰百勝！",
    "start": 6.62,
    "end": 8.84
   }
  ]
 },
 {
  "dur": 7.99,
  "lines": [
   {
    "who": "A",
    "text": "應用程式安全：把安全融入需求、架構、程式、測試到上線的每一步。",
    "start": 0.5,
    "end": 7.39
   }
  ]
 },
 {
  "dur": 7.36,
  "lines": [
   {
    "who": "A",
    "text": "系統與網路安全：從組態、網路服務、區隔到網頁過濾，層層防護。",
    "start": 0.5,
    "end": 6.76
   }
  ]
 },
 {
  "dur": 7.63,
  "lines": [
   {
    "who": "A",
    "text": "供應者關係安全：從協議、供應鏈到雲端服務，管好外部風險。",
    "start": 0.5,
    "end": 7.03
   }
  ]
 },
 {
  "dur": 9.99,
  "lines": [
   {
    "who": "A",
    "text": "資安事件管理：準備、通報、評鑑、回應、學習，並保存證據。",
    "start": 0.5,
    "end": 5.93
   },
   {
    "who": "R",
    "text": "發現可疑事件，要馬上通報喔！",
    "start": 6.23,
    "end": 9.39
   }
  ]
 },
 {
  "dur": 8.42,
  "lines": [
   {
    "who": "A",
    "text": "持續性：以復原時間目標為起點，確保中斷時，資安與資訊服務仍然可用。",
    "start": 0.5,
    "end": 7.82
   }
  ]
 },
 {
  "dur": 8.96,
  "lines": [
   {
    "who": "A",
    "text": "資訊安全保證：透過遵循性審查、獨立審查與安全測試，證明控制有效。",
    "start": 0.5,
    "end": 8.36
   }
  ]
 },
 {
  "dur": 7.57,
  "lines": [
   {
    "who": "A",
    "text": "遵循性：識別法規與契約要求，保護智慧財產、紀錄與個資。",
    "start": 0.5,
    "end": 6.97
   }
  ]
 },
 {
  "dur": 14.98,
  "lines": [
   {
    "who": "A",
    "text": "總結一下：本文告訴我們管理系統怎麼運轉，附錄 A 提供控制措施，運作能力把它們串成可落地的流程。謝謝大家！",
    "start": 0.5,
    "end": 11.66
   },
   {
    "who": "R",
    "text": "謝謝大家，我們下次見～",
    "start": 11.96,
    "end": 14.38
   }
  ]
 }
]
